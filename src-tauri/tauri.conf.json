{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdvim",
  "version": "0.1.0",
  "identifier": "org.mdvim.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mdvim",
        "width": 1100,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
